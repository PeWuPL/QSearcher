{
  "manifest_version": 3,
  "name": "QSearcher",
  "author": "Gal Anonym, who knows, will know.",
  "version": "1.2",
  "description": "Question searcher",
  "permissions": ["tabs", "storage" ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["popup/content_script.js"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon16.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "qsearcher@unknown.extension",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "58.0"
    }
  },
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
